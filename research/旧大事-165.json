[
 {
  "year": 907,
  "text": "朱温代唐称帝，国号梁，史称后梁；唐亡。同年王建称帝于成都（前蜀），马殷据湖南，钱镠据两浙，杨渥承杨行密之业据淮南。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 907,
  "text": "梁封钱镠为吴越王、马殷为楚王，十国藩镇名号自此确立。",
  "place": [
   120.16,
   30.27
  ],
  "src": "《十国春秋·吴越》《十国春秋·楚》"
 },
 {
  "year": 908,
  "text": "李克用卒，子李存勖继晋王位；梁军围潞州，晋军夹寨大破之。",
  "place": [
   113.1,
   36.19
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 908,
  "text": "晋军于潞州夹寨大破梁军，解潞州之围，梁军死者万余。",
  "place": [
   113.1,
   36.19
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 908,
  "text": "吴杨渥遇弑，弟杨隆演继位，徐温专吴政。",
  "place": [
   119.42,
   32.39
  ],
  "src": "《十国春秋·吴》"
 },
 {
  "year": 909,
  "text": "刘守光囚父刘仁恭，据幽州，后称燕帝；王审知受梁封为闽王。",
  "place": [
   116.4,
   39.9
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 909,
  "text": "梁改枢密院为崇政院，以敬翔为崇政院使，机要尽归亲信。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 910,
  "text": "梁遣王景仁等攻成德、义武，镇、定求救于晋，柏乡之战由此而起。",
  "place": [
   114.5,
   38
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 910,
  "text": "吴越钱镠筑捍海石塘，杭州湾潮患始息。",
  "place": [
   120.16,
   30.27
  ],
  "src": "《十国春秋·吴越》"
 },
 {
  "year": 910,
  "text": "梁进封刘隐为南海王，岭南刘氏名位益重。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《十国春秋·南汉》"
 },
 {
  "year": 911,
  "text": "柏乡之战：晋军大破梁军，河北形势逆转。",
  "place": [
   114.53,
   37.48
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 911,
  "text": "清海军节度使刘隐卒，弟刘龑继掌岭南，南汉基业自此始。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 911,
  "text": "刘守光称帝，国号大燕，改元应天。",
  "place": [
   116.4,
   39.9
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 912,
  "text": "朱友珪弑父朱温自立；913 年朱友贞杀友珪即位，是为梁末帝。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 912,
  "text": "朱友珪弑父自立，改元凤历。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 913,
  "text": "晋王李存勖破幽州，灭燕，刘守光父子被俘处死。",
  "place": [
   116.4,
   39.9
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 914,
  "text": "晋军破幽州，刘守光父子被处死，燕亡。",
  "place": [
   116.4,
   39.9
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 915,
  "text": "梁分魏博为天雄、昭德二镇，魏军兵变，晋军乘之南下。",
  "place": [
   115.15,
   36.28
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 916,
  "text": "耶律阿保机称帝，建元神册，契丹国家初具规模。",
  "place": [
   119.2,
   42.85
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 917,
  "text": "刘龑称帝于广州，国号大越，后改汉，史称南汉。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《新五代史·南汉世家》"
 },
 {
  "year": 918,
  "text": "前蜀王建卒，子王衍嗣位，荒游无度。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 918,
  "text": "吴军取虔州，杨氏尽有江西之地。",
  "place": [
   114.94,
   25.83
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 918,
  "text": "契丹围幽州，晋遣李嗣源、李存审等救之，大破契丹于望都。",
  "place": [
   116.4,
   39.9
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 918,
  "text": "前蜀王建卒，子王衍即位。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《十国春秋·前蜀》"
 },
 {
  "year": 918,
  "text": "辽建皇都于临潢，制度渐备。",
  "place": [
   119.2,
   42.85
  ],
  "src": "《辽史·太祖本纪》"
 },
 {
  "year": 919,
  "text": "胡柳陂之战：晋梁两军鏖战竟日，晋将周德威战死，晋军终以奇兵取胜。",
  "place": [
   115,
   35.7
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 919,
  "text": "杨隆演称吴国王，吴始建号。",
  "place": [
   119.42,
   32.39
  ],
  "src": "《十国春秋·吴》"
 },
 {
  "year": 920,
  "text": "晋军于德胜渡筑南北二城，与梁夹河相持，河北战局胶着。",
  "place": [
   115,
   35.6
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 921,
  "text": "成德将张文礼弑节度使王镕，镇州乱，晋军来攻。",
  "place": [
   114.5,
   38
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 921,
  "text": "梁进封钱镠为吴越国王。",
  "place": [
   120.16,
   30.27
  ],
  "src": "《十国春秋·吴越》"
 },
 {
  "year": 922,
  "text": "晋军克镇州，成德镇归晋，河北形势彻底倒向河东。",
  "place": [
   114.5,
   38
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 922,
  "text": "晋将李嗣昭攻镇州，中流矢卒。",
  "place": [
   114.5,
   38
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 923,
  "text": "李存勖称帝于魏州，国号唐（后唐）；唐军破郓州、中都，直取汴梁，梁末帝自杀，后梁亡。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 923,
  "text": "后唐定都洛阳，以汴州为宣武军。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 923,
  "text": "后唐以郭崇韬为枢密使，委以军国重事。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后梁纪"
 },
 {
  "year": 924,
  "text": "李茂贞卒，岐地归后唐；后唐封高季兴为南平王，荆南立国。",
  "place": [
   107.39,
   34.52
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 925,
  "text": "后唐郭崇韬率军灭前蜀，王衍出降。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 925,
  "text": "楚铸铅铁钱，境内货币紊乱，商旅多不便。",
  "place": [
   112.94,
   28.23
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 925,
  "text": "后唐封马殷为楚国王，楚始建國。",
  "place": [
   112.94,
   28.23
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 925,
  "text": "后唐以孟知祥为西川节度使，孟氏据蜀之基自此始。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 925,
  "text": "后唐以魏王李继岌为西川行营都统，郭崇韬副之，伐前蜀。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 926,
  "text": "后唐庄宗死于兴教门之变，李嗣源即位；辽太祖阿保机卒，耶律德光继位。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 926,
  "text": "辽太祖阿保机灭渤海，改东丹国，班师途中卒于扶余。",
  "place": [
   124,
   42.3
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 926,
  "text": "后唐明宗即位，改元天成。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 927,
  "text": "徐温卒，养子徐知诰（李昪）继专吴政，杨氏益孤。",
  "place": [
   119.42,
   32.39
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 927,
  "text": "杨溥称帝，吴改元乾贞；同年徐温卒。",
  "place": [
   119.42,
   32.39
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 927,
  "text": "后唐以冯道为相，历仕之始。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 928,
  "text": "大长和国内乱，杨干贞杀郑隆亶，暂立清平官赵善政，国号大天兴。",
  "place": [
   100.2,
   25.7
  ],
  "src": "《南诏野史》"
 },
 {
  "year": 928,
  "text": "后唐赐钱镠天下兵马大元帅，吴越名位冠诸国。",
  "place": [
   120.16,
   30.27
  ],
  "src": "《十国春秋·吴越》"
 },
 {
  "year": 929,
  "text": "后唐朝廷议削两川支郡，孟知祥、董璋离心，次年遂举兵反。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 929,
  "text": "后唐破定州，王都自焚，河北诸镇平。",
  "place": [
   114.99,
   38.5
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 929,
  "text": "楚王马殷听谗，杀谋臣高郁，楚之财赋自此不振。",
  "place": [
   112.94,
   28.23
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 930,
  "text": "楚王马殷卒，诸子争立，楚政渐衰。",
  "place": [
   112.94,
   28.23
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 930,
  "text": "孟知祥、董璋举兵反后唐，两川遂成割据之势。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 931,
  "text": "后唐权臣安重诲失宠，被诛，明宗朝政局转危。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 931,
  "text": "闽建州王延禀举兵反，兵败被杀。",
  "place": [
   118.3,
   27.03
  ],
  "src": "《十国春秋·闽》"
 },
 {
  "year": 931,
  "text": "吴徐知诰专吴政，出镇金陵，杨氏益孤。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《十国春秋·吴》"
 },
 {
  "year": 932,
  "text": "后唐冯道请以雕版刻印《九经》，官刻经籍自此始。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 932,
  "text": "后唐置端明殿学士，以文臣备顾问。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 932,
  "text": "吴徐知诰出镇金陵，广布亲信，禅代之势渐成。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《十国春秋·吴》"
 },
 {
  "year": 933,
  "text": "后唐明宗卒，李从厚即位，旋为李从珂所废；孟知祥据两川。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 933,
  "text": "后唐秦王李从荣趁父病举兵，事败被杀，明宗惊惧而卒。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 933,
  "text": "后唐以石敬瑭为河东节度使，久镇太原，为其后晋之基。",
  "place": [
   112.55,
   37.87
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 934,
  "text": "孟知祥称帝于成都，国号蜀（后蜀），同年卒，子孟昶嗣位。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 934,
  "text": "李从珂即位，改元清泰，是为后唐末帝。",
  "place": [
   112.45,
   34.62
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 935,
  "text": "闽主王延钧为子王昶所弑，王昶即位。",
  "place": [
   119.3,
   26.08
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 936,
  "text": "石敬瑭引契丹南下，灭后唐，建后晋；割燕云十六州予契丹，岁输绢帛，称\"儿皇帝\"。",
  "place": [
   116.4,
   39.9
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 936,
  "text": "后晋改元天福，石敬瑭即位于汴。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后唐纪"
 },
 {
  "year": 937,
  "text": "李昪代吴建南唐，都金陵；段思平灭大义宁，建大理国。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《新五代史·南唐世家》《南诏野史》"
 },
 {
  "year": 937,
  "text": "南唐以宋齐丘为相，开国制度多出其手。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《十国春秋·南唐》"
 },
 {
  "year": 938,
  "text": "契丹改国号为大辽；后晋上尊号于辽。",
  "place": [
   119.2,
   42.85
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 939,
  "text": "闽主王昶为叔王延羲所杀，闽国宗室相残愈烈。",
  "place": [
   119.3,
   26.08
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 939,
  "text": "闽王延羲即位，宗室相残，闽政愈乱。",
  "place": [
   119.3,
   26.08
  ],
  "src": "《十国春秋·闽》"
 },
 {
  "year": 940,
  "text": "闽王延羲攻建州，王延政据建州自守，闽分裂为二。",
  "place": [
   118.3,
   27.03
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 941,
  "text": "吴越王钱元瓘卒，子钱弘佐嗣位。",
  "place": [
   120.16,
   30.27
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 941,
  "text": "后晋以刘知远为河东节度使，沙陀刘氏复据太原。",
  "place": [
   112.55,
   37.87
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 942,
  "text": "后晋高祖石敬瑭卒，石重贵即位，对辽改称孙不称臣。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 942,
  "text": "后晋出帝立冯氏为皇后，外戚干政之渐。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 943,
  "text": "南唐李昪卒，李璟即位；南汉刘龑卒，刘玢嗣，旋为刘晟所杀。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《十国春秋·南汉》《新五代史·南唐世家》"
 },
 {
  "year": 943,
  "text": "南汉刘晟即位，尽杀诸弟，宗室为之一空。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《十国春秋·南汉》"
 },
 {
  "year": 944,
  "text": "后晋出帝石重贵对辽称孙不称臣，辽军首次南征。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 944,
  "text": "后晋出帝亲征，辽军引退，河北暂安。",
  "place": [
   115,
   38
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 945,
  "text": "南唐乘闽内乱灭闽，王延政出降；闽地分属南唐、吴越。",
  "place": [
   118.3,
   27.03
  ],
  "src": "《十国春秋·闽》"
 },
 {
  "year": 946,
  "text": "辽三度南征，后晋军溃；十二月辽军入汴。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 946,
  "text": "后晋将杜重威率大军降辽，汴梁门户尽失。",
  "place": [
   115,
   38
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 947,
  "text": "辽太宗入汴，后晋亡；刘知远于太原称帝，建后汉，旋入汴；辽太宗北归途中卒。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 947,
  "text": "吴越取福州，闽故地尽分入吴越、南唐。",
  "place": [
   119.3,
   26.08
  ],
  "src": "《十国春秋·吴越》"
 },
 {
  "year": 947,
  "text": "后汉以苏逢吉为中书侍郎、同平章事。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后晋纪"
 },
 {
  "year": 947,
  "text": "闽将李仁达以福州降吴越，闽故地尽分。",
  "place": [
   119.3,
   26.08
  ],
  "src": "《十国春秋·吴越》"
 },
 {
  "year": 948,
  "text": "后汉高祖刘知远卒，隐帝刘承祐即位；吴越钱弘倧被废，钱俶立。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 948,
  "text": "后汉杀杜重威，夷其族，以惩降辽之罪。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 948,
  "text": "后汉改元乾祐，隐帝即位。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 948,
  "text": "后汉以郭威为枢密使，委以兵权。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 948,
  "text": "吴越钱弘倧被废，弟钱俶即位。",
  "place": [
   120.16,
   30.27
  ],
  "src": "《十国春秋·吴越》"
 },
 {
  "year": 949,
  "text": "后汉诛杀功臣杨邠、史弘肇、王章，朝局骤变。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 949,
  "text": "后汉郭威讨平河中李守贞、永兴赵思绾、凤翔王景崇三镇之乱。",
  "place": [
   110.4,
   34.85
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 949,
  "text": "后汉以郭威为天雄军节度使，镇邺都。",
  "place": [
   115.15,
   36.28
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 950,
  "text": "隐帝遣使杀郭威，郭威举兵南下；楚马希萼攻长沙。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 950,
  "text": "楚马希萼攻破长沙，马希广被杀，楚乱愈烈。",
  "place": [
   112.94,
   28.23
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 950,
  "text": "后汉以郭威为邺都留守，督河北诸军御辽。",
  "place": [
   115.15,
   36.28
  ],
  "src": "《资治通鉴》后汉纪"
 },
 {
  "year": 951,
  "text": "郭威建后周；刘崇于太原建北汉；南唐乘楚乱灭楚，周行逢据湖南。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 951,
  "text": "后周太祖罢牛租，除前朝苛敛，民颇便之。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 951,
  "text": "后周以李穀判三司，理财有绩，国用稍充。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 951,
  "text": "后周改元广顺，郭威即位。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 951,
  "text": "后周以王峻为枢密使，总揽机务。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《十国春秋·楚》"
 },
 {
  "year": 952,
  "text": "周行逢逐南唐军，据有湖南。",
  "place": [
   112.94,
   28.23
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 952,
  "text": "后周宰相王峻恃功骄横，失宠贬商州，途中卒。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 952,
  "text": "南唐宰相李建勋卒，元老凋零。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《十国春秋·南唐》"
 },
 {
  "year": 953,
  "text": "后周攻北汉晋阳，久攻不下，引军而还。",
  "place": [
   112.55,
   37.87
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 954,
  "text": "高平之战：后周世宗柴荣大破北汉、辽联军；旋整军理财。",
  "place": [
   112.85,
   35.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 954,
  "text": "后周太祖郭威卒，养子柴荣即位，是为世宗。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 955,
  "text": "后周三征淮南，南唐军节节败退。",
  "place": [
   116.78,
   32.58
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 955,
  "text": "后周世宗废佛寺三万余所，收铜铸钱，以充国用。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 956,
  "text": "后周军围寿州，南唐援军大败于紫金山。",
  "place": [
   116.78,
   32.58
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 957,
  "text": "寿州降；后周尽取淮南诸州。",
  "place": [
   116.78,
   32.58
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 957,
  "text": "后周以赵匡胤为殿前都指挥使，掌禁军。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 958,
  "text": "南唐献江北十四州，去帝号、称国主，用后周年号。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 958,
  "text": "南唐迁都南昌，称洪州，避后周兵锋。",
  "place": [
   115.89,
   28.68
  ],
  "src": "《新五代史·南唐世家》"
 },
 {
  "year": 958,
  "text": "南汉刘晟卒，子刘鋹即位，政事尽委宦官。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《十国春秋·南汉》"
 },
 {
  "year": 959,
  "text": "后周世宗北伐辽，取瓦桥、益津、淤口三关；旋病卒，幼主柴宗训即位。",
  "place": [
   116.1,
   38.7
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 959,
  "text": "后周立皇子柴宗训为梁王，为即位铺路。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 959,
  "text": "后周以赵匡胤为殿前都点检，禁军尽在其手。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 960,
  "text": "陈桥兵变，赵匡胤黄袍加身，建宋；后周亡。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 960,
  "text": "宋以赵普为枢密直学士，参预机要。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 960,
  "text": "陈桥兵变，韩通欲率军抵抗，为王彦升所杀，后周遂亡。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《资治通鉴》后周纪"
 },
 {
  "year": 961,
  "text": "南唐李璟卒，李煜即位；宋太祖\"杯酒释兵权\"。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 961,
  "text": "宋罢殿前都点检，禁军统兵之权尽归三衙。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 962,
  "text": "湖南周行逢卒，幼子周保权继；清源军陈洪进废留绍镃，专有泉漳。",
  "place": [
   112.94,
   28.23
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 963,
  "text": "宋军假道荆南，高继冲纳土；顺势取湖南，周保权被俘。",
  "place": [
   112.24,
   30.33
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 963,
  "text": "宋改元乾德，并置诸路转运使。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 963,
  "text": "宋以赵普为枢密使。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 963,
  "text": "宋以慕容延钊、李处耘平荆湖，高继冲、周保权相继纳土。",
  "place": [
   112.24,
   30.33
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 964,
  "text": "宋遣李继勋等攻北汉，辽出兵救之，宋军引退。",
  "place": [
   112.55,
   37.87
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 964,
  "text": "宋置参知政事，以薛居正、吕余庆为之，分宰相之权。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 964,
  "text": "宋以赵普为门下侍郎、同平章事，专任相权。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 965,
  "text": "宋军两路伐蜀，成都破，孟昶出降，后蜀亡。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《宋史·孟昶传》"
 },
 {
  "year": 965,
  "text": "后蜀将赵崇韬绵州兵败战死，蜀军主力尽溃。",
  "place": [
   104.7,
   31.5
  ],
  "src": "《宋史·孟昶传》"
 },
 {
  "year": 966,
  "text": "宋平定蜀中全师雄之乱，川峡始安。",
  "place": [
   104.07,
   30.66
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 967,
  "text": "定难军节度使李彝兴卒，宋赠夏王，党项李氏世据夏州如故。",
  "place": [
   108.9,
   37.9
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 968,
  "text": "宋太祖罢\"开宝通礼\"；北汉刘承钧卒，刘继恩、刘继元相继立。",
  "place": [
   112.55,
   37.87
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 968,
  "text": "宋攻北汉，辽出兵救援，宋军引退。",
  "place": [
   112.55,
   37.87
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 969,
  "text": "辽穆宗耶律璟醉酒为近侍所杀，耶律贤即位，是为景宗。",
  "place": [
   119.2,
   42.85
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 970,
  "text": "南唐名臣韩熙载卒。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 970,
  "text": "宋以潘美为南汉都部署，筹备南征。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 970,
  "text": "辽北院枢密使萧思温遇刺身亡，景宗朝外戚之祸始。",
  "place": [
   116.4,
   39.9
  ],
  "src": "《辽史·景宗本纪》"
 },
 {
  "year": 971,
  "text": "宋将潘美破广州，刘鋹出降，南汉亡。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《宋史·刘鋹传》"
 },
 {
  "year": 971,
  "text": "宋置市舶司于广州，掌海舶贸易。",
  "place": [
   113.26,
   23.13
  ],
  "src": "《宋史·刘鋹传》"
 },
 {
  "year": 972,
  "text": "宋行反间，南唐后主鸩杀名将林仁肇，自毁长城。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 973,
  "text": "宋诏修梁、唐、晋、汉、周书，后成《旧五代史》。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 973,
  "text": "宋以薛居正监修梁唐晋汉周书，即《旧五代史》。",
  "place": [
   114.35,
   34.8
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 974,
  "text": "宋军分道伐南唐，围金陵。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 974,
  "text": "宋以曹彬为升州西南面行营都部署，总兵伐南唐。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《续资治通鉴长编》"
 },
 {
  "year": 975,
  "text": "金陵城破，李煜出降，南唐亡。",
  "place": [
   118.78,
   32.06
  ],
  "src": "《宋史·李煜传》"
 },
 {
  "year": 975,
